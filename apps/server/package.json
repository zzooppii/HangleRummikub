{
  "name": "@hangul-rummikub/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names compile,serve --prefix-colors blue,green \"tsc --project tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "tsc --project tsconfig.test.json && node --test .test-dist/*.test.js .test-dist/application/*.test.js .test-dist/infrastructure/*.test.js .test-dist/transport/*.test.js",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hangul-rummikub/shared": "0.0.0",
    "express": "5.2.1",
    "socket.io": "4.8.3",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "socket.io-client": "4.8.3"
  }
}
